# --- Core ---
# Port 5433 to avoid clashing with a local Postgres on 5432 (see docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://ipo:ipo@localhost:5433/ipo
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# --- Auth ---
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me

# --- Scheduler ---
# The GitHub Actions cron sends this as the X-Internal-Token header.
INTERNAL_TASK_TOKEN=dev-internal-token

# --- GMP provider (optional; app works fully without it) ---
# "none" or "ipoguru". Free key by email: https://www.ipoguru.in/ipo-gmp-details-developer-api
GMP_PROVIDER=none
IPOGURU_API_KEY=

# --- Notifications (each channel is independently optional) ---
# Email via Resend: https://resend.com  (free tier: 3k/month)
RESEND_API_KEY=
EMAIL_FROM=IPO Tracker <onboarding@resend.dev>

# Telegram: create a bot with @BotFather and paste its token
TELEGRAM_BOT_TOKEN=

# Web push: generate a keypair with `python -m app.cli vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
